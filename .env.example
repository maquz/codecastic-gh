# Codecastic GH - Configuration Template (.env)
# -------------------------------------------------------------------
# Rename this file to .env in your application root, or set these
# Environment Variables directly in cPanel "Setup Node.js App".

# 1. Enterprise MariaDB / MySQL Database
DB_HOST=localhost
DB_NAME=yourcpaneluser_codecastic
DB_USER=yourcpaneluser_dbuser
DB_PASSWORD=YourDatabasePasswordHere!
DB_PORT=3306

# 2. Email Server Configuration (info@codecasticgh.com)
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_USER=info@codecasticgh.com
SMTP_PASS=YourEmailPasswordHere!
NOTIFY_EMAIL=info@codecasticgh.com
